rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* ========================================================
       COMMON HELPERS
       ======================================================== */

    function isSignedIn() {
      return request.auth != null;
    }


    function currentUserExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }


    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }


    function currentUserRole() {
      return currentUser().role;
    }


    function isAdmin() {
      return currentUserExists()
        && currentUserRole() == "ADMIN";
    }


    function isManager() {
      return currentUserExists()
        && currentUserRole() == "MANAGER";
    }


    function isStaff() {
      return currentUserExists()
        && currentUserRole() == "STAFF";
    }


    function isActiveUser() {
      return currentUserExists()
        && currentUser().status == "ACTIVE";
    }


    function hasPermission(permission) {
      return isActiveUser()
        && (
          currentUserRole() == "ADMIN"
          ||
          currentUser().permissions[permission] == true
        );
    }


    /* ========================================================
       USER ACCESS
       ======================================================== */

    match /users/{userId} {

      /*
       * User can read own profile.
       * Admin can read all users.
       */

      allow read:
        if isActiveUser()
        && (
          userId == request.auth.uid
          || isAdmin()
        );


      /*
       * New user profile:
       * only Admin.
       */

      allow create:
        if isAdmin();


      /*
       * User can update limited own profile.
       * Admin can update everything.
       */

      allow update:
        if isAdmin()
        ||
        (
          isActiveUser()
          &&
          userId == request.auth.uid
          &&
          request.resource.data.role ==
            resource.data.role
          &&
          request.resource.data.status ==
            resource.data.status
          &&
          request.resource.data.permissions ==
            resource.data.permissions
        );


      /*
       * Only Admin can delete user.
       */

      allow delete:
        if isAdmin();
    }


    /* ========================================================
       COMPANY SETTINGS
       ======================================================== */

    match /settings/{settingId} {

      /*
       * Active users can read company settings.
       */

      allow read:
        if isActiveUser();


      /*
       * Only Admin can create/update settings.
       */

      allow create, update:
        if isAdmin();


      /*
       * Prevent accidental deletion.
       */

      allow delete:
        if isAdmin();
    }


    /* ========================================================
       CUSTOMERS
       ======================================================== */

    match /customers/{customerId} {

      allow read:
        if hasPermission("customers");


      allow create:
        if hasPermission("customers");


      allow update:
        if hasPermission("customers");


      /*
       * Delete restricted to Admin.
       */

      allow delete:
        if isAdmin();
    }


    /* ========================================================
       SUPPLIERS
       ======================================================== */

    match /suppliers/{supplierId} {

      allow read:
        if hasPermission("suppliers");


      allow create:
        if hasPermission("suppliers");


      allow update:
        if hasPermission("suppliers");


      allow delete:
        if isAdmin();
    }


    /* ========================================================
       INVENTORY
       ======================================================== */

    match /inventory/{itemId} {

      allow read:
        if hasPermission("inventory");


      allow create:
        if hasPermission("inventory");


      allow update:
        if hasPermission("inventory");


      allow delete:
        if isAdmin();
    }


    /* ========================================================
       PRODUCTS
       ======================================================== */

    match /products/{productId} {

      allow read:
        if hasPermission("inventory");


      allow create:
        if hasPermission("inventory");


      allow update:
        if hasPermission("inventory");


      allow delete:
        if isAdmin();
    }


    /* ========================================================
       SALES
       ======================================================== */

    match /sales/{saleId} {

      allow read:
        if hasPermission("sales");


      allow create:
        if hasPermission("sales");


      allow update:
        if hasPermission("sales");


      /*
       * Sales deletion is restricted.
       */

      allow delete:
        if hasPermission("deleteRecords");
    }


    /* ========================================================
       SALES ITEMS
       ======================================================== */

    match /salesItems/{itemId} {

      allow read:
        if hasPermission("sales");


      allow create:
        if hasPermission("sales");


      allow update:
        if hasPermission("sales");


      allow delete:
        if hasPermission("deleteRecords");
    }


    /* ========================================================
       PURCHASES
       ======================================================== */

    match /purchases/{purchaseId} {

      allow read:
        if hasPermission("purchases");


      allow create:
        if hasPermission("purchases");


      allow update:
        if hasPermission("purchases");


      allow delete:
        if hasPermission("deleteRecords");
    }


    /* ========================================================
       PURCHASE ITEMS
       ======================================================== */

    match /purchaseItems/{itemId} {

      allow read:
        if hasPermission("purchases");


      allow create:
        if hasPermission("purchases");


      allow update:
        if hasPermission("purchases");


      allow delete:
        if hasPermission("deleteRecords");
    }


    /* ========================================================
       PAYMENTS
       ======================================================== */

    match /payments/{paymentId} {

      allow read:
        if hasPermission("payments");


      allow create:
        if hasPermission("payments");


      allow update:
        if hasPermission("payments");


      allow delete:
        if hasPermission("deleteRecords");
    }


    /* ========================================================
       RECEIPTS
       ======================================================== */

    match /receipts/{receiptId} {

      allow read:
        if hasPermission("payments");


      allow create:
        if hasPermission("payments");


      allow update:
        if hasPermission("payments");


      allow delete:
        if hasPermission("deleteRecords");
    }


    /* ========================================================
       SUPPLIER PAYMENTS
       ======================================================== */

    match /supplierPayments/{paymentId} {

      allow read:
        if hasPermission("payments");


      allow create:
        if hasPermission("payments");


      allow update:
        if hasPermission("payments");


      allow delete:
        if hasPermission("deleteRecords");
    }


    /* ========================================================
       REPORTS / SUMMARY DATA
       ======================================================== */

    match /reports/{reportId} {

      allow read:
        if hasPermission("reports");


      /*
       * Reports should normally be
       * generated by application logic.
       */

      allow create, update:
        if isAdmin();


      allow delete:
        if isAdmin();
    }


    /* ========================================================
       NOTIFICATIONS
       ======================================================== */

    match /notifications/{notificationId} {

      allow read:
        if isActiveUser();


      allow create:
        if isActiveUser();


      /*
       * User can update notification read state.
       */

      allow update:
        if isActiveUser();


      allow delete:
        if isAdmin();
    }


    /* ========================================================
       QUOTATIONS
       ======================================================== */

    match /quotations/{quotationId} {

      allow read:
        if hasPermission("sales");


      allow create:
        if hasPermission("sales");


      allow update:
        if hasPermission("sales");


      allow delete:
        if hasPermission("deleteRecords");
    }


    /* ========================================================
       EXPENSES
       ======================================================== */

    match /expenses/{expenseId} {

      allow read:
        if hasPermission("payments");


      allow create:
        if hasPermission("payments");


      allow update:
        if hasPermission("payments");


      allow delete:
        if hasPermission("deleteRecords");
    }


    /* ========================================================
       CATEGORIES
       ======================================================== */

    match /categories/{categoryId} {

      allow read:
        if isActiveUser();


      allow create:
        if hasPermission("inventory");


      allow update:
        if hasPermission("inventory");


      allow delete:
        if isAdmin();
    }


    /* ========================================================
       UNITS
       ======================================================== */

    match /units/{unitId} {

      allow read:
        if isActiveUser();


      allow create:
        if hasPermission("inventory");


      allow update:
        if hasPermission("inventory");


      allow delete:
        if isAdmin();
    }


    /* ========================================================
       COMPANY / BRANCH
       ======================================================== */

    match /branches/{branchId} {

      allow read:
        if isActiveUser();


      allow create, update:
        if isAdmin();


      allow delete:
        if isAdmin();
    }


    /* ========================================================
       AUDIT / ACTIVITY
       ======================================================== */

    match /activityLogs/{logId} {

      /*
       * Users may read only when they
       * have reporting access.
       */

      allow read:
        if hasPermission("reports");


      /*
       * Application can create logs
       * for active users.
       */

      allow create:
        if isActiveUser();


      /*
       * Logs should never be edited/deleted
       * by normal users.
       */

      allow update, delete:
        if isAdmin();
    }


    /* ========================================================
       DEFAULT DENY
       ======================================================== */

    match /{document=**} {

      allow read, write:
        if false;

    }

  }

}
